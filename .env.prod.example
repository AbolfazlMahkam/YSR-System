# =====================================================================
# YSR-System — production environment example
# Copy to `.env.prod` and fill real values:  cp .env.prod.example .env.prod
# Compose reads it via:  docker compose -f docker-compose.prod.yml --env-file .env.prod ...
# Regenerate ALL secrets before a real deploy (the values below are throwaway).
# =====================================================================

# ---------------------------------------------------------------------
# Public hostnames
# ---------------------------------------------------------------------
# Browser-visible frontend origin (scheme+host+port). MUST exactly match where the
# SPA is served, or backend CORS (credentials:true) blocks auth cookies.
FRONTEND_URL=https://app.example.com

# Host port the frontend (nginx) is published on (maps to container :80).
FRONTEND_PORT=8080

# Host port the backend is published on (maps to container :3000).
BACKEND_PORT=3000

# ---------------------------------------------------------------------
# Frontend BUILD-TIME vars (baked into the JS bundle by `vite build`).
# Changing these requires REBUILDING the frontend image — a restart does nothing.
# Public values only; never put secrets here.
# ---------------------------------------------------------------------
# PUBLIC backend URL the browser calls (NOT the internal compose name).
VITE_API_BASE_URL=https://api.example.com
# External OAuth client id — leave EMPTY until provisioned.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------
# Postgres / backend database
# These MUST match the backend DB_* values (same user/password/db).
# ---------------------------------------------------------------------
DB_USERNAME=ysr
DB_DATABASE=ysr_prod
# Strong random password (regenerate: openssl rand -base64 30 | tr -d '/+=')
DB_PASSWORD=ratolLqYY8wpME9FvWAaPgL59NkiqclxgDZjynS

# ---------------------------------------------------------------------
# Backend secrets (regenerate each: openssl rand -hex 32)
# ---------------------------------------------------------------------
JWT_SECRET=725ef646e39219221e7d8701d4b4fba8ba643ee24b36487537b0dd2fb1c901e5
JWT_EXPIRES_IN=1d
SESSION_SECRET=c3bf1932feb09f35bdac6bf50448e9f3a13413eacd5ad785dff661d7b4a4a2a8

# ---------------------------------------------------------------------
# External credentials — leave EMPTY / placeholder, fill per-deployment
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
